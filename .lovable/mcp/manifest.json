      {
        "name": "list_my_bills",
        "title": "List my bills",
        "description": "List the signed-in resident's estate bills (title, amount, due date, status), newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional status filter, e.g. pending, paid or waived.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows to return (default 20, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_guest_invites",
        "title": "List guest invites",
        "description": "List guest invites visible to the signed-in user (residents see their own), newest visit first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional status filter, e.g. pending or used.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows to return (default 20, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_guest_invite",
        "title": "Create guest invite",
        "description": "Create a gate access code for a visitor of the signed-in resident. Returns the invite code.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "guest_name": {
              "type": "string",
              "description": "Visitor's full name."
            },
            "visit_time": {
              "description": "ISO timestamp of the expected visit. Defaults to now.",
              "type": "string"
            },
            "valid_hours": {
              "description": "How many hours the code stays valid from the visit time (default 24).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "num_guests": {
              "description": "Number of visitors (default 1).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "phone": {
              "description": "Visitor phone number.",
              "type": "string"
            },
            "purpose": {
              "description": "Reason for the visit.",
              "type": "string"
            },
            "vehicle_number": {
              "description": "Visitor vehicle plate number.",
              "type": "string"
            }
          },
          "required": [
            "guest_name"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_notifications",
        "title": "List my notifications",
        "description": "List the signed-in user's Estate Guard notifications, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
