          "properties": {
            "unread_only": {
              "description": "Only return notifications not yet read.",
              "type": "boolean"
            },
            "limit": {
              "description": "Maximum rows to return (default 20, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
