# Copy to .env.e2e and fill in real credentials before running Playwright.
# NEVER commit real values.
BASE_URL=http://localhost:8080

E2E_RESIDENT_EMAIL=
E2E_RESIDENT_PASSWORD=

E2E_GUARD_EMAIL=
E2E_GUARD_PASSWORD=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_SUPER_EMAIL=
E2E_SUPER_PASSWORD=

# Optional: a valid guest code in the guard's estate for validation flow tests.
E2E_GUEST_CODE_VALID=
E2E_GUEST_CODE_EXPIRED=
E2E_GUEST_CODE_REVOKED=
